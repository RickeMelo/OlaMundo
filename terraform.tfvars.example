# Example Terraform variables file
# Copy this file to terraform.tfvars and customize the values

# AWS region where resources will be created
aws_region = "us-west-2"

# Project name (used for resource naming)
project_name = "my-ec2-project"

# VPC CIDR block
vpc_cidr = "10.0.0.0/16"

# Public subnet CIDR block
public_subnet_cidr = "10.0.1.0/24"

# EC2 instance type
instance_type = "t3.micro"

# Your SSH public key (replace with your actual public key)
# Generate with: ssh-keygen -t rsa -b 4096 -f ~/.ssh/my-key
# Then copy the content of ~/.ssh/my-key.pub
public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC... your-email@example.com"